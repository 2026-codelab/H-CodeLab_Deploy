# 서버의 /home/codelab/hcl/.env 원본. scripts/gen-env.sh 가 이 형식으로 .env 를 만들어 준다.
# .env 는 절대 git 에 올리지 않는다.

# ===== 서버 =====
# 사용자가 접속하는 주소 (도메인 없으면 http://서버IP, HTTPS 적용 후 https://도메인)
SITE_URL=http://ai.walab.info
# HTTPS 를 적용했으면 true, http 로만 쓰면 false
COOKIE_SECURE=false
# judgehost 가 쓰지 않는 CPU 코어 (우리 서버: 0-3 과 그 하이퍼스레드 짝 24-27)
SYSTEM_CPUS=0-3,24-27
# 서버의 docker 그룹 번호 (getent group docker | cut -d: -f3)
DOCKER_GID=999

# ===== DB / Redis =====
WEB_DB_ROOT_PASSWORD=
WEB_DB_PASSWORD=
DOM_DB_ROOT_PASSWORD=
DOM_DB_PASSWORD=
REDIS_PASSWORD=

# ===== 백엔드 =====
JWT_SECRET_KEY=
# 힌트용 LLM (OpenAI 호환 API). 연구실 로컬 LLM(vLLM): https://ai.walab.info/v1, 모델 lab-llm
LLM_BASE_URL=https://ai.walab.info/v1
LLM_API_KEY=
LLM_MODEL=lab-llm
# 비밀번호 재설정 메일 (선택, Gmail 주소와 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== DOMjudge (6단계에서 채운다) =====
JUDGEDAEMON_PASSWORD=
DOMJUDGE_API_USER=admin
DOMJUDGE_API_PASSWORD=
