# 서버의 /home/codelab/hcl/.env 원본. scripts/gen-env.sh 가 이 형식으로 .env 를 만들어 준다.
# .env 는 절대 git 에 올리지 않는다.

# ===== 서버 =====
# 사용자가 접속하는 주소 (도메인 없으면 http://서버IP, HTTPS 적용 후 https://도메인)
SITE_URL=http://203.252.112.153
# HTTPS 를 적용했으면 true, http 로만 쓰면 false
COOKIE_SECURE=false
# judgehost 가 쓰지 않는 CPU 코어 (153 서버: 0-1 과 그 하이퍼스레드 짝 16-17)
SYSTEM_CPUS=0-1,16-17
# 서버의 docker 그룹 번호 (getent group docker | cut -d: -f3)
DOCKER_GID=999

# ===== DB / Redis =====
WEB_DB_ROOT_PASSWORD=
WEB_DB_PASSWORD=
DOM_DB_ROOT_PASSWORD=
DOM_DB_PASSWORD=
REDIS_PASSWORD=

# ===== 백엔드 =====
JWT_SECRET_KEY=
# 힌트용 연구실 로컬 LLM (vLLM). 키는 LLM 서버의 /etc/vllm/env 에 있는 값
LLM_BASE_URL=https://ai.walab.info/v1
LLM_API_KEY=
LLM_MODEL=lab-llm
# 비밀번호 재설정 메일 (선택, Gmail 주소와 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== DOMjudge (6단계에서 채운다) =====
JUDGEDAEMON_PASSWORD=
DOMJUDGE_API_USER=admin
DOMJUDGE_API_PASSWORD=

# ===== 테스트하기 실행기 =====
# domjudge: 기존 DOMjudge 경로, runner: 모든 분반이 실행기 사용
TESTRUN_EXECUTOR=runner
TESTRUN_DB_PASSWORD=
TESTRUN_SERVICE_TOKEN=
TESTRUN_INTERNAL_TOKEN=
# 슬롯마다 혼자 쓰는 CPU 코어 (쉼표 구분). 서버마다 달라서 직접 채운다. 비어 있으면 runner 가 뜨지 않는다.
# 개수는 RUNNER_SLOTS 와 맞춘다 (코어가 모자라도 오류 없이 나눠 써서 실행 시간이 흔들린다). judgehost·SYSTEM_CPUS 와 겹치면 안 된다.
RUNNER_SLOTS=2
RUNNER_CPUS=6,7
